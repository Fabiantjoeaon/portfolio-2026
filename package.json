{
  "name": "@three-blocks/starter",
  "private": false,
  "version": "0.0.12",
  "type": "module",
  "devDependencies": {
    "@three-blocks/devtools": "^13.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "canvas-record": "^5.5.0",
    "eslint": "^9.39.1",
    "eslint-config-mdcs": "^5.0.0",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.14",
    "lil-gui": "^0.20.0",
    "makio-meshline": "^1.4.0",
    "n8ao-webgpu": "^0.1.0",
    "three": "^0.186.0",
    "three-blocks": "^0.14.0",
    "tone": "^15.1.22",
    "txt-shuffle": "^1.0.3"
  },
  "scripts": {
    "dev": "vite dev --host",
    "dev:lan": "vite dev --host --mode lan --port 4443",
    "build": "vite build",
    "preview": "vite preview --host",
    "start": "vite build && vite preview --host --port 4000",
    "video:optimize": "node scripts/optimize-videos.mjs",
    "media:projects": "node scripts/optimize-projects.mjs",
    "seo:images": "node scripts/capture-og-images.mjs",
    "media:projects:mobile": "node scripts/optimize-projects.mjs --only mobile",
    "fonts:msdf": "node scripts/generate-msdf.mjs && npm run textures:bake",
    "textures:bake": "node scripts/bake-textures.mjs",
    "audio:generate": "node scripts/audio/generate.mjs",
    "audio:test": "node --test scripts/audio/generate.test.mjs scripts/audio/midi.test.mjs"
  }
